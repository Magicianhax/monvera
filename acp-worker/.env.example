# Virtuals ACP seller worker — copy to .env and fill in.

# The dev wallet you whitelisted in the ACP dashboard (Session > Whitelist).
# This key signs job memos ONLY; it never holds user funds.
WHITELISTED_WALLET_PRIVATE_KEY=0x...

# From the ACP dashboard after whitelisting (the session entity key id).
SELLER_ENTITY_ID=1

# Vera's registered ACP agent wallet (the smart wallet from app.virtuals.io/acp).
SELLER_AGENT_WALLET_ADDRESS=0x...

# Optional: your own Base RPC for fewer rate limits / better gas estimates.
# ACP_RPC_URL=https://...

# The shared key that authorizes this worker against monvera.best/api/agent/plan.
# Must equal ACP_PLAN_KEY in the web app's environment (set via wrangler secret).
ACP_PLAN_KEY=

# Override for local testing against a dev server:
# MONVERA_PLAN_URL=http://localhost:3000/api/agent/plan
