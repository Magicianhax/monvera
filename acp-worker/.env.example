# Virtuals ACP seller worker (v2 SDK) - fill from the agent wallet page.

# Agent wallet EVM address (top of the wallet page, 0xbc2e...ca90).
SELLER_WALLET_ADDRESS=

# The EVM WALLET ID field on the wallet page (Privy wallet id).
SELLER_WALLET_ID=

# The private key from Signers > Add Signer (base64, starts with MIGH...,
# policy: Virtuals-only). Copy it from the dialog before closing.
SELLER_SIGNER_PRIVATE_KEY=

# Shared key for monvera.best/api/agent/plan (must match the CF secret).
ACP_PLAN_KEY=

# Override for local testing against a dev server:
# MONVERA_PLAN_URL=http://localhost:3000/api/agent/plan

# ---- Test buyer (second registered agent, for sandbox testing) ----
BUYER_WALLET_ADDRESS=
BUYER_WALLET_ID=
BUYER_SIGNER_PRIVATE_KEY=
