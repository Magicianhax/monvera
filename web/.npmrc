# The dependency graph has a genuine upstream peer conflict: Privy's stack
# (@base-org/account) pins ox@0.6.9 while permissionless declares a
# peerOptional on ox@^0.8.0. The app only exercises permissionless's simple
# account path, which never touches the ox APIs that differ, and the shipped
# production tree has always resolved this way. Strict peer resolution would
# refuse to install at all, so clean installs must use the same relaxed
# resolution the working tree was built with.
legacy-peer-deps=true
