# Build-time constants for PRODUCTION builds (CI and local deploys).
# Everything here is public by construction: NEXT_PUBLIC_* values ship
# verbatim inside the client bundle at monvera.best, so this file adds no
# exposure. One value deliberately does NOT belong here:
#   NEXT_PUBLIC_RPC_URL       keyed endpoint -> GitHub Actions secret
# Locally, .env.local overrides this file (Next.js env precedence).
#
# Anything the app needs at RUNTIME must live here, not only in .env.local:
# .env.local is gitignored, so a Cloudflare Workers Build (which builds from
# the repo) cannot see it. On 2026-08-04 NEXT_PUBLIC_GROVE_MANAGER was local
# only, so every local deploy shipped a working app and every CI build then
# deployed one with an empty address over it — Titan flipped between live and
# "Opens soon" depending on who deployed last.

NEXT_PUBLIC_CHAIN_ID=4663
# GroveManager on 4663, live since 2026-08-04. A public contract address.
NEXT_PUBLIC_GROVE_MANAGER=0x5ee5df3e027fd5d9a3fbba4cb19b0edeb4b33fb8
NEXT_PUBLIC_EXPLORER_URL=
NEXT_PUBLIC_IDENTITY_REGISTRY=0x751ae640cfa816404b017fbb8234dd21abafbbdc
NEXT_PUBLIC_INFERENCE_VERIFIER=0x7ff1a5ee19330c165146488a7ad8af6cb41da1df
NEXT_PUBLIC_SEASON_START=1784851200
NEXT_PUBLIC_STAX_AGENT_ID=1
NEXT_PUBLIC_STAX_EXECUTOR=0x7ff1a5ee19330c165146488a7ad8af6cb41da1df
NEXT_PUBLIC_STAX_EXECUTOR_BLOCK=2429508
NEXT_PUBLIC_PRIVY_APP_ID=cmr58ebmd001m0bjo73m1wgp1
NEXT_PUBLIC_PRIVY_SIGNER_ID=a9sexzghqmfmd3j8ajrcybum
