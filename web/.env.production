# Build-time constants for PRODUCTION builds (CI and local deploys).
# Everything here is public by construction: NEXT_PUBLIC_* values ship
# verbatim inside the client bundle at monvera.best, so this file adds no
# exposure. Two values deliberately do NOT belong here:
#   NEXT_PUBLIC_RPC_URL       keyed endpoint -> GitHub Actions secret
#   NEXT_PUBLIC_GROVE_MANAGER groves are not released -> stays local
# Locally, .env.local overrides this file (Next.js env precedence).

NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_EXPLORER_URL=
