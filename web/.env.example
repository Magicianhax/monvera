# Web app env — copy to .env.local and fill in. Do NOT put real secrets in this
# committed file. App runs on Robinhood Chain; trading via the Arcus spot router.

# ── Chain: Robinhood Chain (Arbitrum-stack L2, native gas ETH) ───────────────
# Mainnet 4663 (default) or testnet 46630. Leave the RPC blank to use the public
# endpoint (rate-limited), or set an Alchemy Robinhood key for production, e.g.
# https://robinhood-mainnet.g.alchemy.com/v2/<key>.
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_EXPLORER_URL=

# ── Auth + embedded wallet: Privy (https://dashboard.privy.io) ───────────────
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# ── Gasless (ERC-4337): Pimlico (https://dashboard.pimlico.io) ───────────────
# Verified to support Robinhood Chain 4663. Add a paymaster sponsorship policy
# for chain 4663 in the Pimlico dashboard so trades are truly gasless for users.
PIMLICO_API_KEY=

# ── Trading venue: Arcus spot RFQ router ─────────────────────────────────────
# Public, no key. Leave ARCUS_ROUTER_URL blank to use the default host.
# ARCUS_REFERRAL_CODE (optional) is our affiliate code — earns a kickback on the
# volume we route (register at Arcus to get one).
ARCUS_ROUTER_URL=
ARCUS_REFERRAL_CODE=NANI

# ── AI (the agent): Virtuals primary, Venice/Anthropic fallbacks ─────────────
# Virtuals compute = the builder inference credits claimed by the registered
# Vera agent (app.virtuals.io). OpenAI-compatible; live models at
# GET https://compute.virtuals.io/v1/models. Preferred when the key is set.
VIRTUALS_API_KEY=
VIRTUALS_MODEL=anthropic-claude-opus-4-8
VIRTUALS_BASE_URL=https://compute.virtuals.io/v1
VENICE_API_KEY=
VENICE_MODEL=claude-opus-4-7
VENICE_BASE_URL=https://api.venice.ai/api/v1
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-6

# ── Optional: Alchemy (better RPC + wallet transaction history on Robinhood) ──
ALCHEMY_API_KEY=

# ── Optional: Autopilot (autonomous DCA agent) ───────────────────────────────
# Store = Cloudflare D1 (schema in migrations/, applied with
# `npx wrangler d1 migrations apply monvera --remote`); scheduler = Cloudflare
# Cron Triggers (wrangler.jsonc + worker.ts). Privy session-signer for delegated
# signing. Not needed for spot trading.
NEXT_PUBLIC_PRIVY_SIGNER_ID=
PRIVY_AUTHORIZATION_KEY=
AUTOPILOT_CRON_SECRET=

# ── Trust layer on Robinhood Chain (VeraRecord + IdentityRegistry, 2026-07-04) ──
# VeraRecord verifies Vera's EIP-712 risk inference and records every plan
# on-chain, in the same batch as the Arcus buys. AGENT_SIGNER_PRIVATE_KEY is the
# hot key whose address the contract trusts (server-side only, never client).
NEXT_PUBLIC_STAX_EXECUTOR=0x7ff1a5ee19330c165146488a7ad8af6cb41da1df
NEXT_PUBLIC_INFERENCE_VERIFIER=0x7ff1a5ee19330c165146488a7ad8af6cb41da1df
NEXT_PUBLIC_IDENTITY_REGISTRY=0x751ae640cfa816404b017fbb8234dd21abafbbdc
NEXT_PUBLIC_STAX_AGENT_ID=1
NEXT_PUBLIC_STAX_EXECUTOR_BLOCK=2429508
AGENT_SIGNER_PRIVATE_KEY=

# Optional: media CDN base (Cloudflare R2). Defaults to the monvera-assets
# bucket public URL in lib/assets.ts; set when the bucket moves behind a domain.
NEXT_PUBLIC_ASSETS_BASE=

# Rialto swap API (fallback stock venue when Arcus is dry/failing) - docs.rialto.xyz
RIALTO_API_KEY=
# Our integrator fee on Rialto fills, in bps (paid to the registered fee_recipient in-tx). 0/unset = no fee.
RIALTO_FEE_BPS=25

# Per-venue kill switches (on|off). Arcus is PAUSED by default (settles failing);
# set VENUE_ARCUS=on to bring it back. Rialto stays inert until RIALTO_API_KEY.
VENUE_ARCUS=off
VENUE_RIALTO=on
VENUE_LIFI=on
VENUE_UNISWAP=on

# Uniswap venue fees + future Trading API access. The Trading API does NOT
# cover chain 4663 yet, so routing is on-chain (V4Quoter + UniversalRouter)
# and the 25 bps fee is taken via the router's PAY_PORTION command, paid to
# UNISWAP_FEE_RECIPIENT in the output token. UNISWAP_API_KEY is a placeholder
# for when trade-api.gateway.uniswap.org adds Robinhood Chain.
UNISWAP_API_KEY=
UNISWAP_FEE_BPS=25
UNISWAP_FEE_RECIPIENT=0xc6d7709dd8ba53832bd578a88260f8b8e59fb4c7
