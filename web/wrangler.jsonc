{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Custom entry wraps the OpenNext worker and adds scheduled() for Cron Triggers.
  "main": "worker.ts",
  "name": "monvera",
  "compatibility_date": "2026-07-04",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Cloudflare Cron Triggers → worker.ts scheduled() → /api/cron/autopilot.
  // Hourly: the route itself claims only autopilots that are actually due.
  "triggers": {
    "crons": ["0 * * * *", "*/15 * * * *", "0 13 * * 1"]
  },
  // The app's home. monvera.best / www / assets are attached in the dashboard;
  // this one is config-managed. Middleware serves the app at "/" here.
  "routes": [
    { "pattern": "app.monvera.best", "custom_domain": true }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Autopilot store (configs + run log). Schema in ./migrations.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "monvera",
      "database_id": "e23da4ba-b78c-4423-a9a6-973a8455d467",
      "migrations_dir": "migrations"
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "monvera"
    }
  ],
  // Cross-isolate cache (Vera's on-chain record scan, etc). Isolates recycle
  // constantly; without this each cold one re-scanned the chain (~60s).
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "261d14429e574a209be09659d23a628e"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}
